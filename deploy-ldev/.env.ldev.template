# ─────────────────────────────────────────────────────────────────
# Acufy Timesheet — Lightsail dev (ldev) environment template
#
# Copy this file to deploy-ldev/.env.ldev (which is gitignored) and
# fill in the values. The build-and-ship script reads .env.ldev to
# bake build-args into the frontend image and ship the runtime env
# to the host.
#
# DO NOT commit deploy-ldev/.env.ldev with real values.
# ─────────────────────────────────────────────────────────────────

# ── Database (already created on ldb.acufy.ai) ───────────────────
# Both DBs are owned by timesheet_user_ldev. pg_hba.conf grants
# scram-sha-256 access for this role from any host.
DATABASE_URL=postgresql+asyncpg://timesheet_user_ldev:__DB_PASSWORD__@ldb.acufy.ai:5432/timesheet_ldev
CONTROL_DATABASE_URL=postgresql+asyncpg://timesheet_user_ldev:__DB_PASSWORD__@ldb.acufy.ai:5432/acufy_control_ldev

# ── JWT (use a fresh secret for ldev) ─────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=__REPLACE_ME__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ──────────────────────────────────────────────────────────
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_BASE_URL=https://user.webilent.tm.ldev.acufy.ai

# CORS - origin where the frontend is served from. ldev only.
CORS_ORIGINS=["https://user.webilent.tm.ldev.acufy.ai"]

# ── Encryption (rotate from the dev key; ldev needs its own) ─────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=__REPLACE_ME__

# ── Storage ──────────────────────────────────────────────────────
STORAGE_PATH=./uploads
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── OpenAI (ingestion pipeline) ──────────────────────────────────
OPENAI_API_KEY=__REPLACE_ME__

# ── Google OAuth (Gmail mailbox ingestion) ───────────────────────
GOOGLE_CLIENT_ID=__REPLACE_ME__
GOOGLE_CLIENT_SECRET=__REPLACE_ME__
GOOGLE_REDIRECT_URI=https://user.webilent.tm.ldev.acufy.ai/api/auth/oauth/callback/google

# ── Microsoft OAuth (Outlook mailbox ingestion) ──────────────────
MICROSOFT_CLIENT_ID=__REPLACE_ME__
MICROSOFT_CLIENT_SECRET=__REPLACE_ME__
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://user.webilent.tm.ldev.acufy.ai/api/auth/oauth/callback/microsoft

# ── Worker / arq job settings ────────────────────────────────────
WORKER_CRON_MINUTES=0,5,10,15,20,25,30,35,40,45,50,55
WORKER_JOB_TIMEOUT=300
WORKER_MAX_TRIES=3
WORKER_KEEP_RESULT=86400
EMAIL_FETCH_INTERVAL_MINUTES=60
EMAIL_FETCH_DAYS=mon,tue,wed,thu,fri
EMAIL_FETCH_START_TIME=00:00
EMAIL_FETCH_END_TIME=23:59
EMAIL_FETCH_INITIAL_DAYS=30

# ── Licensing (SaaS mode; license fields unused) ─────────────────
DEPLOYMENT_MODE=saas
LICENSE_KEY=
LICENSE_API_URL=https://user.webilent.tm.ldev.acufy.ai
LICENSE_PHONE_HOME_INTERVAL_HOURS=720
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_SIGNING_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_SERVER_HASH_SALT=__REPLACE_ME__
LICENSE_VALIDATE_TOKEN=

# ── Auth0 (identity provider, reuse from frontend/.env) ──────────
AUTH0_DOMAIN=dev-3tia4fme5i7ws48r.us.auth0.com
AUTH0_CLIENT_ID=2Sw0TBhoXT2VsHon50b6HmvjgEWP3Qnm
AUTH0_CLIENT_SECRET=__REPLACE_ME__
AUTH0_AUDIENCE=https://timesheet-api
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_CONNECTION_ID=__REPLACE_ME__
AUTH0_MGMT_CLIENT_ID=__REPLACE_ME__
AUTH0_MGMT_CLIENT_SECRET=__REPLACE_ME__

# ── Build args for the frontend image ────────────────────────────
# These get baked into the JS bundle at build time. Used by
# build-and-ship.ps1. Not needed at runtime.
VITE_API_BASE_URL=https://user.webilent.tm.ldev.acufy.ai
VITE_BASE_PATH=/
VITE_AUTH0_DOMAIN=dev-3tia4fme5i7ws48r.us.auth0.com
VITE_AUTH0_CLIENT_ID=2Sw0TBhoXT2VsHon50b6HmvjgEWP3Qnm
VITE_AUTH0_AUDIENCE=https://timesheet-api
VITE_AUTH0_CONNECTION=Username-Password-Authentication
